# ==============================================================================
# ENTRIVO - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# 1. DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/entrivo"

# 2. AUTHENTICATION & SECURITY
JWT_SECRET="generate_a_random_32_char_hex_secret_here"
QR_SIGNING_SECRET="generate_a_random_32_char_hex_secret_here"
CRON_SECRET="generate_a_random_32_char_hex_secret_for_cron"
SEED_ADMIN_PASSWORD=""
APP_ENCRYPTION_KEY="generate_32_byte_base64_encryption_key"

# 3. GOOGLE OAUTH & SSO
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# 4. MAILJET EMAIL ENGINE
MAILJET_API_KEY="mock_mailjet_api_key_entrivo"
MAILJET_SECRET_KEY="mock_mailjet_secret_key_entrivo"
EMAIL_FROM="no-reply@entrivo.com"
EMAIL_FROM_NAME="Entrivo Workplace Concierge"

# 5. WEB PUSH NOTIFICATIONS (VAPID)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@entrivo.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# 6. CLOUDINARY FILE STORAGE
CLOUDINARY_CLOUD_NAME="entrivo-cloud"
CLOUDINARY_API_KEY="mock_cloudinary_key"
CLOUDINARY_API_SECRET="mock_cloudinary_secret"

# 7. REDIS & BACKGROUND QUEUES
REDIS_URL="redis://localhost:6379"

# 8. APP METADATA
NEXT_PUBLIC_APP_NAME="Entrivo"
NEXT_PUBLIC_APP_TAGLINE="Modern Workplace Visitor Management Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
