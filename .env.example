# ==============================================================================
# ENTRIVO - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# 1. DATABASE
DATABASE_URL="postgresql://postgres:123@localhost:5432/entrivo"

# 2. AUTHENTICATION & SECURITY
JWT_SECRET="generate_a_random_32_char_hex_secret_here"
NEXTAUTH_SECRET="generate_another_random_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# 3. GOOGLE OAUTH
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 4. MAILJET EMAIL ENGINE
MAILJET_API_KEY="mock_mailjet_api_key_entrivo"
MAILJET_SECRET_KEY="mock_mailjet_secret_key_entrivo"
EMAIL_FROM="no-reply@entrivo.com"
EMAIL_FROM_NAME="Entrivo Workplace Concierge"

# 5. WHATSAPP BUSINESS CLOUD API
WHATSAPP_PHONE_NUMBER_ID="mock_whatsapp_phone_number_id"
WHATSAPP_ACCESS_TOKEN="mock_whatsapp_cloud_api_token"
WHATSAPP_BUSINESS_ACCOUNT_ID="mock_waba_account_id"

# 6. CLOUDINARY FILE STORAGE
CLOUDINARY_CLOUD_NAME="entrivo-cloud"
CLOUDINARY_API_KEY="mock_cloudinary_key"
CLOUDINARY_API_SECRET="mock_cloudinary_secret"

# 7. REDIS
REDIS_URL="redis://localhost:6379"

# 8. APP METADATA
NEXT_PUBLIC_APP_NAME="Entrivo"
NEXT_PUBLIC_APP_TAGLINE="Modern Workplace Visitor Management Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
