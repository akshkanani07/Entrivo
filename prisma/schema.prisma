generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  logo                   String?
  domain                 String?
  address                String?
  city                   String?
  country                String?                 @default("India")
  contactEmail           String?
  contactPhone           String?
  checkInPolicy          String?
  workingHours           String?                 @default("08:30 - 19:30")
  timezone               String                  @default("Asia/Kolkata")
  brandColor             String?                 @default("#4f46e5")
  locale                 String?                 @default("en-IN")
  deletedAt              DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  apiKeys                ApiKey[]
  auditLogs              AuditLog[]
  badgeTemplates         BadgeTemplate[]
  blacklists             BlacklistVisitor[]
  branches               Branch[]
  calendarConnections    CalendarConnection[]
  departments            Department[]
  documents              Document[]
  employees              Employee[]
  files                  File[]
  holidays               Holiday[]
  invitations            Invitation[]
  kiosks                 Kiosk[]
  ndaTemplates           NdaTemplate[]
  preRegistrations       PreRegistration[]
  notifications          Notification[]
  emailSuppressions      EmailSuppression[]
  invitationSeries       InvitationSeries[]
  notificationTemplates  NotificationTemplate[]
  pushSubscriptions      PushSubscription[]
  reports                Report[]
  securityLogs           SecurityLog[]
  settings               Setting[]
  users                  User[]
  visitors               Visitor[]
  visitorNotes           VisitorNote[]
  vehicles               Vehicle[]
  parkingLots            ParkingLot[]
  parkingAssignments     ParkingAssignment[]
  parkingEvents          ParkingEvent[]
  contractorPermits      ContractorPermit[]
  visitorTypes           VisitorType[]
  webhookDeliveries      WebhookDelivery[]
  webhooks               WebhookSubscription[]
  emergencyEvents        EmergencyEvent[]
  musterPoints           MusterPoint[]
  bulkImportJobs         BulkImportJob[]
  deliveries             Delivery[]
  deliveryPersonLogs     DeliveryPersonLog[]
  contractorCompanies    ContractorCompany[]
  contractorWorkers      ContractorWorker[]
  complianceRequirements ComplianceRequirement[]
  feedbackRequests       FeedbackRequest[]
  feedbackResponses      FeedbackResponse[]
  selfCheckinPoints     SelfCheckinPoint[]
  selfCheckinSessions   SelfCheckinSession[]

  @@index([slug])
}

model Branch {
  id              String           @id @default(cuid())
  name            String
  code            String
  address         String?
  workingHours    Json?
  organizationId  String
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  holidays        Holiday[]
  emergencyEvents EmergencyEvent[]
  offices         Office[]

  @@index([organizationId])
}

model Office {
  id              String           @id @default(cuid())
  name            String
  floor           String?
  building        String?
  workingHours    Json?
  branchId        String
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  employees       Employee[]
  emergencyEvents EmergencyEvent[]
  floors          Floor[]
  meetingRooms    MeetingRoom[]
  musterPoints    MusterPoint[]
  parkingLots     ParkingLot[]
  selfCheckinPoints SelfCheckinPoint[]
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
}

model Department {
  id             String       @id @default(cuid())
  name           String
  code           String
  organizationId String
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees      Employee[]

  @@index([organizationId])
}

model User {
  id                       String                   @id @default(cuid())
  email                    String                   @unique
  googleId                 String?                  @unique
  passwordHash             String
  name                     String
  avatar                   String?
  avatarUrl                String?
  phone                    String?
  lastLoginProvider        LoginProvider            @default(PASSWORD)
  role                     UserRole                 @default(EMPLOYEE)
  locale                   String?
  isTwoFactorEnabled       Boolean                  @default(false)
  twoFactorSecret          String?
  twoFactorBackupCodes     String?
  twoFactorConfirmedAt     DateTime?
  isEmailVerified          Boolean                  @default(false)
  isActive                 Boolean                  @default(true)
  organizationId           String?
  mustChangePassword       Boolean                  @default(false)
  passwordChangedAt        DateTime?
  quietHoursEnabled        Boolean                  @default(false)
  quietHoursStart          String?                  @default("22:00")
  quietHoursEnd            String?                  @default("07:00")
  termsAcceptedAt          DateTime?
  termsVersion             String?
  deletedAt                DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  auditLogs                AuditLog[]
  visitorNotes             VisitorNote[]
  calendarConnections      CalendarConnection[]
  employee                 Employee?
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  approvedTemplates        NotificationTemplate[]   @relation("TemplateApprover")
  reviewedPreRegistrations PreRegistration[]        @relation("PreRegistrationReviewer")
  passwordHistories        PasswordHistory[]
  pushSubscriptions        PushSubscription[]
  sessions                 Session[]
  startedEmergencyEvents   EmergencyEvent[]         @relation("EmergencyStartedBy")
  accountedMusterEntries   MusterAccountEntry[]     @relation("MusterAccountedBy")
  musterAccountActions     MusterAccountAction[]    @relation("MusterAccountActionBy")
  parkingEventsRecorded    ParkingEvent[]           @relation("ParkingEventRecorder")
  emergencyDeliveries      EmergencyDelivery[]
  createdInvitationSeries  InvitationSeries[]       @relation("InvitationSeriesCreator")
  approvedInvitationSeries InvitationSeries[]       @relation("InvitationSeriesApprover")
  createdBulkImportJobs    BulkImportJob[]          @relation("BulkImportJobCreator")
  confirmedSelfCheckinSessions SelfCheckinSession[] @relation("SelfCheckinConfirmedBy")
  walkinApprovalOverrides    Approval[]               @relation("WalkinApprovalOverride")
  organization             Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  device       String?
  ipAddress    String?
  userAgent    String?
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
  @@index([tokenHash])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  purpose   String    @default("RESET")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
  @@index([tokenHash])
}

model Employee {
  id                   String              @id @default(cuid())
  userId               String              @unique
  organizationId       String
  departmentId         String?
  officeId             String?
  managerId            String?
  employeeCode         String
  designation          String?
  phone                String?
  status               String              @default("AVAILABLE")
  autoApproveVisitors  Boolean             @default(false)
  backupApproverId     String?
  deletedAt            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  approvalsGiven       Approval[]
  checkInsHosted       CheckIn[]
  backupApprover       Employee?           @relation("BackupApprover", fields: [backupApproverId], references: [id])
  backupFor            Employee[]          @relation("BackupApprover")
  manager              Employee?           @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports        Employee[]          @relation("EmployeeManager")
  feedbackResponses    FeedbackResponse[]
  department           Department?         @relation(fields: [departmentId], references: [id])
  office               Office?             @relation(fields: [officeId], references: [id])
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitations          Invitation[]
  invitationSeries     InvitationSeries[]
  bulkImportJobs       BulkImportJob[]
  deliveriesReceived   Delivery[]          @relation("DeliveryReceivedBy")
  deliveriesRecipient  Delivery[]          @relation("DeliveryRecipient")
  sponsoredContractors ContractorCompany[] @relation("ContractorSponsor")
  selfCheckinSessions SelfCheckinSession[] @relation("SelfCheckinHost")

  @@index([organizationId])
  @@index([departmentId])
  @@index([managerId])
}

model VisitorType {
  id               String       @id @default(cuid())
  name             String
  description      String?
  badgeColor       String       @default("#6366f1")
  requiresApproval Boolean      @default(true)
  requiresEscort   Boolean      @default(false)
  requiresNDA      Boolean      @default(false)
  organizationId   String
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  visitors         Visitor[]
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Visitor {
  id                  String              @id @default(cuid())
  name                String
  email               String
  phone               String
  preferredLocale     String              @default("en-IN")
  company             String?
  avatarUrl           String?
  idProofType         String?
  idProofNumber       String?
  idProofNumberMasked String?
  idProofUrl          String?
  isBlacklisted       Boolean             @default(false)
  isVip               Boolean             @default(false)
  isRegularVendor     Boolean             @default(false)
  blacklistReason     String?
  consentGiven        Boolean             @default(true)
  consentVersion      String?             @default("v1.0")
  organizationId      String
  visitorTypeId       String?
  deletedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  badges              Badge[]
  notes               VisitorNote[]
  checkIns            CheckIn[]
  documents           Document[]
  invitations         Invitation[]
  invitationVisitors  InvitationVisitor[]
  invitationSeries    InvitationSeries[]
  preRegistrations    PreRegistration[]
  vehicles            Vehicle[]
  contractorPermits   ContractorPermit[]
  contractorWorkers   ContractorWorker[]
  selfCheckinSessions SelfCheckinSession[]
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitorType         VisitorType?        @relation(fields: [visitorTypeId], references: [id])

  @@index([email])
  @@index([phone])
  @@index([organizationId])
}

model VisitorNote {
  id             String       @id @default(cuid())
  organizationId String
  visitorId      String
  authorUserId   String?
  content        String       @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitor        Visitor      @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  author         User?        @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, visitorId, createdAt])
  @@index([authorUserId])
}

model Invitation {
  id                 String              @id @default(cuid())
  organizationId     String
  hostEmployeeId     String
  visitorId          String
  meetingRoomId      String?
  scheduledDate      DateTime
  startTime          String              @default("10:00")
  endTime            String              @default("11:00")
  visitorReminder24hSentAt DateTime?
  visitorReminder1hSentAt  DateTime?
  purpose            String
  notes              String?
  status             InvitationStatus    @default(PENDING)
  qrToken            String              @unique
  passUrl            String?
  calendarEventId    String?
  calendarProvider   String?
  seriesId           String?
  occurrenceDate     DateTime?
  isException        Boolean             @default(false)
  isWalkIn           Boolean             @default(false)
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  approvals          Approval[]
  checkIns           CheckIn[]
  hostEmployee       Employee            @relation(fields: [hostEmployeeId], references: [id], onDelete: Cascade)
  meetingRoom        MeetingRoom?        @relation(fields: [meetingRoomId], references: [id])
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitor            Visitor             @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  qrCodes            QRCode[]
  preRegistrations   PreRegistration[]
  visitors           InvitationVisitor[]
  series             InvitationSeries?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  parkingAssignments ParkingAssignment[]
  selfCheckinSessions SelfCheckinSession[]

  @@unique([seriesId, occurrenceDate])
  @@index([qrToken])
  @@index([organizationId])
  @@index([organizationId, status, isWalkIn])
  @@index([scheduledDate])
}

model InvitationVisitor {
  id           String                  @id @default(cuid())
  invitationId String
  visitorId    String
  status       InvitationVisitorStatus @default(INVITED)
  qrToken      String                  @unique
  createdAt    DateTime                @default(now())
  invitation   Invitation              @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  visitor      Visitor                 @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@unique([invitationId, visitorId])
  @@index([visitorId])
  @@index([invitationId, status])
}

model InvitationSeries {
  id              String                 @id @default(cuid())
  organizationId  String
  hostEmployeeId  String
  visitorId       String?
  groupDefinition Json?
  rule            Json
  purpose         String
  startDate       DateTime
  endDate         DateTime?
  count           Int?
  startTime       String
  endTime         String
  meetingRoomId   String?
  timezone        String
  skipHolidays    Boolean                @default(false)
  status          InvitationSeriesStatus @default(ACTIVE)
  generatedUntil  DateTime?
  preApproved     Boolean                @default(false)
  approvedById    String?
  createdById     String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hostEmployee    Employee               @relation(fields: [hostEmployeeId], references: [id], onDelete: Cascade)
  visitor         Visitor?               @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  meetingRoom     MeetingRoom?           @relation(fields: [meetingRoomId], references: [id], onDelete: SetNull)
  createdBy       User                   @relation("InvitationSeriesCreator", fields: [createdById], references: [id], onDelete: Cascade)
  approvedBy      User?                  @relation("InvitationSeriesApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  invitations     Invitation[]

  @@index([organizationId, status])
  @@index([hostEmployeeId])
}

model CheckIn {
  id                 String               @id @default(cuid())
  visitorId          String
  invitationId       String?
  hostEmployeeId     String
  checkInTime        DateTime             @default(now())
  hostNotifiedAt     DateTime?
  meetingStartedAt   DateTime?
  expectedCheckout   DateTime?
  photoUrl           String?
  signatureUrl       String?
  badgeNumber        String?
  badgeIssued        Boolean              @default(false)
  ndaSigned          Boolean              @default(false)
  consentGiven       Boolean              @default(true)
  consentVersion     String?              @default("v1.0")
  status             CheckInStatus        @default(CHECKED_IN)
  floorId            String?
  zoneId             String?
  receptionistName   String?
  securityGuardName  String?
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  badges             Badge[]
  hostEmployee       Employee             @relation(fields: [hostEmployeeId], references: [id], onDelete: Cascade)
  invitation         Invitation?          @relation(fields: [invitationId], references: [id])
  musterEntries      MusterAccountEntry[]
  visitor            Visitor              @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  checkOut           CheckOut?
  parkingAssignments ParkingAssignment[]
  floor              Floor?               @relation(fields: [floorId], references: [id], onDelete: SetNull)
  qrCodes            QRCode[]
  feedbackRequest    FeedbackRequest?
  feedbackResponses  FeedbackResponse[]
  selfCheckinSession SelfCheckinSession?
  zone               Zone?                @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([status, floorId, zoneId])
  @@index([badgeNumber])
  @@index([checkInTime])
  @@index([visitorId])
  @@index([hostEmployeeId])
  @@index([checkInTime, status])
  @@index([floorId])
  @@index([zoneId])
  @@index([hostEmployeeId, checkInTime])
  @@index([hostNotifiedAt])
  @@index([meetingStartedAt])
}

model CheckOut {
  id               String          @id @default(cuid())
  checkInId        String          @unique
  emergencyEventId String?
  checkOutTime     DateTime        @default(now())
  durationMinutes  Int             @default(0)
  checkoutMethod   String          @default("MANUAL")
  exitNotes        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  checkIn          CheckIn         @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  emergencyEvent   EmergencyEvent? @relation(fields: [emergencyEventId], references: [id], onDelete: SetNull)

  @@index([emergencyEventId])
  @@index([checkOutTime])
  @@index([durationMinutes])
}

model FeedbackRequest {
  id             String           @id @default(cuid())
  organizationId String
  checkInId      String           @unique
  tokenHash      String           @unique
  expiresAt      DateTime
  sentAt         DateTime?
  channelSentVia FeedbackChannel?
  consumedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkIn        CheckIn          @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt])
  @@index([organizationId, sentAt])
  @@index([checkInId])
}

model FeedbackResponse {
  id               String             @id @default(cuid())
  organizationId   String
  checkInId        String?
  hostEmployeeId   String?
  branchId         String?
  officeId         String?
  npsScore         Int
  csatScore        Int?
  categories       FeedbackCategory[]
  comment          String?            @db.Text
  locale           String             @default("en-IN")
  isAnonymous      Boolean            @default(false)
  source           FeedbackSource     @default(EMAIL)
  ipHash           String?
  profanityFlagged Boolean            @default(false)
  reviewedAt       DateTime?
  reviewedById     String?
  internalNote     String?            @db.Text
  createdAt        DateTime           @default(now())
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkIn          CheckIn?           @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  hostEmployee     Employee?          @relation(fields: [hostEmployeeId], references: [id], onDelete: SetNull)

  @@unique([checkInId])
  @@index([organizationId, createdAt])
  @@index([organizationId, npsScore, createdAt])
  @@index([organizationId, hostEmployeeId, createdAt])
  @@index([organizationId, branchId, createdAt])
  @@index([checkInId])
  @@index([hostEmployeeId])
  @@index([reviewedAt])
}

model QRCode {
  id           String      @id @default(cuid())
  code         String      @unique
  token        String      @unique
  qrType       String      @default("INVITATION")
  invitationId String?
  checkInId    String?
  expiresAt    DateTime
  isUsed       Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  checkIn      CheckIn?    @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  invitation   Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([token])
}

model Badge {
  id          String    @id @default(cuid())
  badgeNumber String    @unique
  visitorId   String
  checkInId   String
  printCount  Int       @default(1)
  issuedAt    DateTime  @default(now())
  expiresAt   DateTime?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  checkIn     CheckIn   @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  visitor     Visitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([badgeNumber])
}

model BadgeTemplate {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  layoutType     String       @default("STANDARD")
  badgeColor     String       @default("#4f46e5")
  showPhoto      Boolean      @default(true)
  showQrCode     Boolean      @default(true)
  showHost       Boolean      @default(true)
  showCompany    Boolean      @default(true)
  customHeader   String?
  customFooter   String?
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Approval {
  id           String         @id @default(cuid())
  invitationId String
  approverId   String
  step         String         @default("HOST")
  status       ApprovalStatus @default(PENDING)
  comments     String?
  approvedAt   DateTime?
  approvedById String?
  overrideReason String?
  escalatedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  approvedBy   User?          @relation("WalkinApprovalOverride", fields: [approvedById], references: [id], onDelete: SetNull)
  approver     Employee       @relation(fields: [approverId], references: [id], onDelete: Cascade)
  invitation   Invitation     @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@index([approverId])
  @@index([status, escalatedAt])
}

model MeetingRoom {
  id               String             @id @default(cuid())
  name             String
  officeId         String
  capacity         Int                @default(6)
  floor            String?
  floorId          String?
  zoneId           String?
  amenities        String?            @default("Display, Conference Phone, Whiteboard")
  isAvailable      Boolean            @default(true)
  deletedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  invitations      Invitation[]
  invitationSeries InvitationSeries[]
  floorRef         Floor?             @relation(fields: [floorId], references: [id])
  office           Office             @relation(fields: [officeId], references: [id], onDelete: Cascade)
  zoneRef          Zone?              @relation(fields: [zoneId], references: [id])

  @@index([officeId])
  @@index([floorId])
  @@index([zoneId])
}

model Document {
  id                  String             @id @default(cuid())
  organizationId      String
  visitorId           String?
  contractorCompanyId String?
  contractorWorkerId  String?
  title               String
  docType             String             @default("ID_PROOF")
  fileUrl             String?
  fileId              String?
  fileSize            Int?
  mimeType            String?
  sha256              String?
  expiryDate          DateTime?
  status              String             @default("VALID")
  metadata            Json?
  verified            Boolean            @default(true)
  createdById         String?
  deletedAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  file                File?              @relation(fields: [fileId], references: [id])
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitor             Visitor?           @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  contractorCompany   ContractorCompany? @relation(fields: [contractorCompanyId], references: [id], onDelete: Cascade)
  contractorWorker    ContractorWorker?  @relation(fields: [contractorWorkerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([visitorId])
  @@index([docType])
  @@index([expiryDate])
  @@index([status])
  @@index([contractorCompanyId])
  @@index([contractorWorkerId])
}

enum ContractorCompanyStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum ContractorWorkerStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  BLOCKED
}

model ContractorCompany {
  id                String                  @id @default(cuid())
  organizationId    String
  name              String
  gstin             String?
  contactName       String?
  contactEmail      String?
  contactPhone      String?
  status            ContractorCompanyStatus @default(ACTIVE)
  contractStart     DateTime?
  contractEnd       DateTime?
  sponsorEmployeeId String
  deletedAt         DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sponsorEmployee   Employee                @relation("ContractorSponsor", fields: [sponsorEmployeeId], references: [id], onDelete: Restrict)
  workers           ContractorWorker[]
  documents         Document[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@index([sponsorEmployeeId])
  @@index([contractEnd])
}

model ComplianceRequirement {
  id                 String       @id @default(cuid())
  organizationId     String
  docType            String
  title              String
  mandatoryForAccess Boolean      @default(true)
  validityRules      Json?
  isActive           Boolean      @default(true)
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
