  bulkImportUploads BulkImportJob[] @relation("BulkImportUpload")
  bulkImportReports BulkImportJob[] @relation("BulkImportErrorReport")
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([ownerType, ownerId])
}

enum DeliveryStatus {
  RECEIVED
  NOTIFIED
  COLLECTED
  RETURNED
  UNCLAIMED
}

model Delivery {
  id                  String         @id @default(cuid())
  organizationId      String
  recipientEmployeeId String
  courierCompany      String
  trackingNumber      String?
  packageCount        Int            @default(1)
  description         String?
  photoFileId         String?
  receivedById        String
  receivedAt          DateTime       @default(now())
  status              DeliveryStatus @default(RECEIVED)
  storageLocation     String?
  pickupCodeHash      String?
  collectedAt         DateTime?
  collectedByName     String?
  signatureFileId     String?
  notes               String?
  reminder24hSentAt   DateTime?
  reminder72hSentAt   DateTime?
  unclaimedAt         DateTime?
  deletedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipientEmployee   Employee       @relation("DeliveryRecipient", fields: [recipientEmployeeId], references: [id], onDelete: Cascade)
  receivedBy          Employee       @relation("DeliveryReceivedBy", fields: [receivedById], references: [id], onDelete: Cascade)

  @@index([organizationId, status, receivedAt])
  @@index([organizationId, courierCompany])
  @@index([organizationId, recipientEmployeeId])
  @@index([organizationId, trackingNumber])
  @@index([receivedAt])
}

model DeliveryPersonLog {
  id             String       @id @default(cuid())
  organizationId String
  name           String?
  company        String
  entryTime      DateTime     @default(now())
  recordedById   String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entryTime])
  @@index([organizationId, company])
}

model BulkImportJob {
  id                String              @id @default(cuid())
  organizationId    String
  createdById       String
  hostEmployeeId    String
  fileId            String
  totalRows         Int                 @default(0)
  validRows         Int                 @default(0)
  errorRows         Int                 @default(0)
  status            BulkImportJobStatus @default(PREVIEW)
  errorReportFileId String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy         User                @relation("BulkImportJobCreator", fields: [createdById], references: [id], onDelete: Cascade)
  hostEmployee      Employee            @relation(fields: [hostEmployeeId], references: [id], onDelete: Cascade)
  file              File                @relation("BulkImportUpload", fields: [fileId], references: [id], onDelete: Cascade)
  errorReportFile   File?               @relation("BulkImportErrorReport", fields: [errorReportFileId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([createdById])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
  @@index([tokenHash])
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

